selected_scheme scheme-custom
collection-basic 1
collection-latex 1
collection-latexrecommended 1
collection-fontsrecommended 1
collection-fontutils 1
collection-bibtexextra 1
collection-pictures 1

# Exclude these (unless you specifically need them)
collection-latexextra 0
collection-xetex 0
collection-luatex 0
collection-fontsextra 0
collection-context 0
collection-humanities 0
collection-langcjk 0
collection-langcyrillic 0
collection-langczechslovak 0
collection-langenglish 0
collection-langeuropean 0
collection-langfrench 0
collection-langgerman 0
collection-langgreek 0
collection-langitalian 0
collection-langother 0
collection-langpolish 0
collection-langportuguese 0
collection-langspanish 0
collection-metapost 0
collection-music 0
collection-pstricks 0
collection-publishers 0
collection-xetex 0

# Disable doc and source files
tlpdbopt_install_docfiles 0
tlpdbopt_install_srcfiles 0

# Paths (keep these defaults, you might need to change them if you plan to install to a different location)
TEXDIR /usr/local/texlive/2024
TEXMFLOCAL /usr/local/texlive/texmf-local
TEXMFSYSVAR /usr/local/texlive/2024/texmf-var
TEXMFSYSCONFIG /usr/local/texlive/2024/texmf-config
TEXMFVAR /root/texmf-var
TEXMFCONFIG /root/texmf-config
TEXMFHOME /root/texmf

# Options
instopt_adjustpath 1
instopt_adjustrepo 0
instopt_letter 0
instopt_portable 0
instopt_write18_restricted 1
tlpdbopt_autobackup 1
tlpdbopt_backupdir tlpkg/backups
tlpdbopt_create_formats 1
tlpdbopt_desktop_integration 0
tlpdbopt_file_assocs 0
tlpdbopt_generate_updmap 0
tlpdbopt_install_docfiles 0
tlpdbopt_install_srcfiles 0
tlpdbopt_post_code 1
tlpdbopt_sys_bin /usr/local/bin
tlpdbopt_sys_info /usr/local/share/info
tlpdbopt_sys_man /usr/local/share/man